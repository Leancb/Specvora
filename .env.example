OPENAI_API_KEY=
SPECVORA_AI_ENABLED=false
SPECVORA_MODEL=gpt-5-mini
SPECVORA_DATA_DIR=./data
SPECVORA_WORKSPACE_DIR=./workspaces
SPECVORA_ALLOWED_HOSTS=localhost,127.0.0.1,petstore3.swagger.io,jsonplaceholder.typicode.com,www.saucedemo.com
SPECVORA_PORTAL_AUTH_MODE=local-development
SPECVORA_PORTAL_USERS_FILE=./.specvora-auth/users.json
SPECVORA_PORTAL_SESSION_KEY=./.specvora-auth/session.key
SPECVORA_PORTAL_SESSION_MINUTES=30
SPECVORA_PORTAL_COOKIE_SECURE=false

